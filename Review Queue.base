views:
  - type: table
    name: Changed since verified
    filters:
      and:
        - status == "draft"
        - '!changes_since_verified.isEmpty()'
        - '!file.inFolder("_templates")'
    order:
      - file.name
      - type
      - verified_on
      - changes_since_verified
  - type: table
    name: Waiting for review
    filters:
      and:
        - status == "draft"
        - changes_since_verified.isEmpty()
        - '!file.inFolder("_templates")'
    order:
      - file.name
      - type
      - courses
      - drafted_on
  - type: table
    name: Verified
    filters:
      and:
        - status == "verified"
        - '!file.inFolder("_templates")'
    order:
      - file.name
      - type
      - courses
      - verified_on
